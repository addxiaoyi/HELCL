<Application xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="HelL.Desktop.App" RequestedThemeVariant="Dark">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="HelL.DesktopPanel">#EBFFFFFF</SolidColorBrush>
          <SolidColorBrush x:Key="HelL.DesktopPanelBorder">#160F172A</SolidColorBrush>
          <SolidColorBrush x:Key="HelL.Muted">#56647B</SolidColorBrush>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="HelL.DesktopPanel">#DE1B1F27</SolidColorBrush>
          <SolidColorBrush x:Key="HelL.DesktopPanelBorder">#22FFFFFF</SolidColorBrush>
          <SolidColorBrush x:Key="HelL.Muted">#A6B1C0</SolidColorBrush>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
      <FontFamily x:Key="DefaultFontFamily">avares://HelL.Desktop/Assets/Fonts#Noto Sans SC</FontFamily>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://HelL.Desktop/Assets/Design/AvaloniaTokens.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://HelL.Desktop/Themes/Controls.axaml" />
  </Application.Styles>
</Application>
