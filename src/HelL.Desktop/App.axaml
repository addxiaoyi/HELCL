<Application xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="HelL.Desktop.App" RequestedThemeVariant="Dark">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="HelL.DesktopPanel">#40FFFFFF</SolidColorBrush>
          <SolidColorBrush x:Key="HelL.Chrome">#40FFFFFF</SolidColorBrush>
          <SolidColorBrush x:Key="HelL.Surface">#40FFFFFF</SolidColorBrush>
          <SolidColorBrush x:Key="HelL.SurfaceRaised">#80FFFFFF</SolidColorBrush>
          <SolidColorBrush x:Key="HelL.Muted">#334155</SolidColorBrush>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="HelL.DesktopPanel">#700D0F14</SolidColorBrush>
          <SolidColorBrush x:Key="HelL.Chrome">#70090B10</SolidColorBrush>
          <SolidColorBrush x:Key="HelL.Surface">#700D0F14</SolidColorBrush>
          <SolidColorBrush x:Key="HelL.SurfaceRaised">#99101620</SolidColorBrush>
          <SolidColorBrush x:Key="HelL.Field">#40090B10</SolidColorBrush>
          <SolidColorBrush x:Key="HelL.Muted">#D2DBE8</SolidColorBrush>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
      <FontFamily x:Key="DefaultFontFamily">avares://HelL.Desktop/Assets/Fonts#Noto Sans SC</FontFamily>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://HelL.Desktop/Assets/Design/AvaloniaTokens.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://HelL.Desktop/Themes/Controls.axaml" />
  </Application.Styles>
</Application>
