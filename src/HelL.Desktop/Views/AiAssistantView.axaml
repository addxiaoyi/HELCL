<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:HelL.Desktop.Controls"
             xmlns:icons="using:HelL.Design"
             x:Class="HelL.Desktop.Views.AiAssistantView">
  <Grid Margin="48,10,48,22" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="14" MaxWidth="760">
    <!-- 极简顶栏 -->
    <Grid ColumnDefinitions="*,Auto,Auto">
      <StackPanel Spacing="3" VerticalAlignment="Center">
        <TextBlock Text="助手" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" />
        <TextBlock x:Name="ProviderSubtitle" Classes="muted" FontSize="12" VerticalAlignment="Center" />
      </StackPanel>
      <Button Grid.Column="1" Classes="icon-btn" Click="ToggleConfig" Margin="0,0,8,0" ToolTip.Tip="连接设置" AutomationProperties.Name="连接设置"><icons:LauncherIcon Kind="CogOutline" Width="16" Height="16"/></Button>
      <Button x:Name="ClearChatButton" Grid.Column="2" Classes="icon-btn" Click="ClearConversation" ToolTip.Tip="清空对话" AutomationProperties.Name="清空对话"><icons:LauncherIcon Kind="TrashCanOutline" Width="16" Height="16"/></Button>
    </Grid>

    <!-- 按需展开的 macOS 分组连接设置 -->
    <Border x:Name="ConfigPanel" Grid.Row="1" Classes="inset-group" Padding="18,14" IsVisible="False">
      <StackPanel Spacing="10">
        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" RowSpacing="10" ColumnSpacing="12">
          <StackPanel Spacing="5">
          <TextBlock Text="服务类型" Classes="group-header" />
          <ComboBox x:Name="ModePicker" SelectedIndex="0" HorizontalAlignment="Stretch" SelectionChanged="ModeChanged" AutomationProperties.Name="AI 服务类型">
            <ComboBoxItem Content="本地 Ollama" Tag="ollama" />
            <ComboBoxItem Content="OpenAI 兼容云端" Tag="custom" />
            <ComboBoxItem Content="公共网关" Tag="public" />
          </ComboBox>
          </StackPanel>
          <StackPanel Grid.Column="1" Spacing="5">
            <TextBlock Text="模型名称" Classes="group-header" />
            <TextBox x:Name="ModelBox" Text="qwen2.5:7b" PlaceholderText="填写服务支持的模型名称" AutomationProperties.Name="AI 模型名称" />
          </StackPanel>
          <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Spacing="5">
            <TextBlock Text="服务地址" Classes="group-header" />
            <TextBox x:Name="EndpointBox" Text="http://127.0.0.1:11434/v1" PlaceholderText="https://api.openai.com/v1" AutomationProperties.Name="AI 服务地址" />
          </StackPanel>
        </Grid>
        <Grid x:Name="ApiKeyRow" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="5" ColumnSpacing="8" IsVisible="False">
          <TextBlock Text="API 密钥" Classes="group-header" />
          <TextBox x:Name="ApiKeyBox" Grid.Row="1" PasswordChar="●" PlaceholderText="留空可保留此服务已保存的密钥" AutomationProperties.Name="AI API 密钥" />
          <Button Grid.Column="1" Grid.Row="1" Content="保存连接" Classes="accent" Click="SaveConfig" />
        </Grid>
        <TextBlock x:Name="ConfigError" Classes="error" TextWrapping="Wrap" IsVisible="False" AutomationProperties.LiveSetting="Polite" />
        <TextBlock x:Name="ConnectionHint" Classes="muted" FontSize="12" TextWrapping="Wrap" />
        <Button x:Name="SaveLocalButton" Content="保存连接" Classes="accent" HorizontalAlignment="Left" Click="SaveConfig" />
      </StackPanel>
    </Border>

    <!-- 留白对话画布（类似 ChatGPT macOS 原生客户端，无多余大外框） -->
    <ScrollViewer x:Name="ChatScroll" Grid.Row="2" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Spacing="16">
        <StackPanel x:Name="StarterPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16" Margin="0,68,0,24">
          <TextBlock Text="需要排查什么问题？" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
          <TextBlock Text="点击建议填入问题，编辑后再发送。" Classes="muted" FontSize="12" HorizontalAlignment="Center" />
          <WrapPanel HorizontalAlignment="Center" MaxWidth="540">
            <Button Content="分析当前实例日志" Classes="tag-chip" Click="DiagnoseLatestLog" Margin="4" />
            <Button Content="1.21.1 性能优化模组" Classes="tag-chip" Tag="请列出适合 Minecraft 1.21.1 Fabric 的简洁帧率优化模组建议。" Click="UseStarterPrompt" Margin="4" />
            <Button Content="加载器差异对比" Classes="tag-chip" Tag="请简明对比 Fabric、Forge 与 NeoForge 的适用场景。" Click="UseStarterPrompt" Margin="4" />
            <Button Content="内存分配建议" Classes="tag-chip" Tag="16GB 内存电脑运行原版光影与模组整合包分别推荐分配多少 MB 内存？" Click="UseStarterPrompt" Margin="4" />
          </WrapPanel>
        </StackPanel>

        <ItemsControl x:Name="MessageItems">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="14" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Background="{Binding BubbleBg}" CornerRadius="10" Padding="15,12" Margin="{Binding BubbleMargin}" HorizontalAlignment="{Binding BubbleAlign}" MaxWidth="680">
                <StackPanel Spacing="8">
                  <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsAssistant}">
                    <TextBlock Text="{Binding Speaker}" FontSize="12" Classes="muted" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                      <TextBlock Text="{Binding StateHint}" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                      <Button Content="复制" Classes="ghost" Tag="{Binding Content}" Click="CopyBubbleText" MinHeight="28" Padding="8,2" FontSize="12" />
                    </StackPanel>
                  </Grid>
                  <local:MessageDocument Text="{Binding Content}" />
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>

    <!-- 底部圆润输入胶囊 -->
    <Border Grid.Row="3" Classes="inset-group" Padding="12,8" CornerRadius="14">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
        <TextBox x:Name="PromptInput" AcceptsReturn="True" BorderThickness="0" Background="Transparent" MinHeight="36" MaxHeight="110" TextWrapping="Wrap" PlaceholderText="输入问题或粘贴报错日志…" VerticalAlignment="Center" AutomationProperties.Name="AI 提问输入框" />
        <StackPanel Grid.Column="1" Spacing="5">
        <Button x:Name="RetryPromptButton" Content="重试本条" Classes="soft" IsVisible="False" Click="RetryPrompt" HorizontalAlignment="Left" />
        <Button x:Name="LatestReplyButton" Content="跳到最新回复" Classes="soft" IsVisible="False" Click="JumpToLatest" HorizontalAlignment="Left" />
        <Button x:Name="SendButton" Grid.Column="1" Content="发送" Classes="accent" VerticalAlignment="Bottom" Click="SendPrompt" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
