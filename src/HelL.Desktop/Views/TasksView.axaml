<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="HelL.Desktop.Views.TasksView">
  <Grid Margin="48,10,48,24" RowDefinitions="Auto,Auto,*,Auto" MaxWidth="760">
    <StackPanel Orientation="Horizontal" Spacing="10" Margin="2,0,0,14">
      <TextBlock Text="任务队列" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" />
      <TextBlock x:Name="CountLabel" Text="暂无任务" Classes="muted" FontSize="12.5" VerticalAlignment="Center" />
    </StackPanel>

    <Grid Grid.Row="1" ColumnDefinitions="*,140" ColumnSpacing="8" Margin="0,0,0,14">
      <TextBox x:Name="SearchBox" PlaceholderText="筛选任务…" AutomationProperties.Name="搜索任务" />
      <ComboBox x:Name="StatePicker" Grid.Column="1" HorizontalAlignment="Stretch" SelectedIndex="0" SelectionChanged="FilterTasks" AutomationProperties.Name="任务状态">
        <ComboBoxItem Content="全部" Tag="all" />
        <ComboBoxItem Content="进行中" Tag="active" />
        <ComboBoxItem Content="失败" Tag="failed" />
        <ComboBoxItem Content="已完成" Tag="completed" />
        <ComboBoxItem Content="已取消" Tag="cancelled" />
      </ComboBox>
    </Grid>

    <Grid Grid.Row="2" RowDefinitions="Auto,*" RowSpacing="14">
      <Border ClipToBounds="True">
        <Grid>
          <ListBox x:Name="TaskList" Classes="rows" MaxHeight="240" SelectionChanged="ChooseTask" AutomationProperties.Name="最近任务记录">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
                  <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="Medium" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,12,0" />
                  <Border Grid.Column="1" Classes="task-state" Classes.failed="{Binding IsFailed}" CornerRadius="6" Padding="7,1.5" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StateLabel}" FontSize="12" />
                  </Border>
                  <Grid Grid.Row="1" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                    <TextBlock Text="{Binding Message}" Classes="muted" FontSize="12.5" LineHeight="20" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" Text="{Binding StartedLabel}" Classes="muted" FontSize="12" Margin="12,0,0,0" />
                  </Grid>
                  <ProgressBar Grid.Row="2" Grid.ColumnSpan="2" MinWidth="0" HorizontalAlignment="Stretch" Height="2.5" Margin="0,6,0,0" IsVisible="{Binding IsActive}" IsIndeterminate="{Binding Indeterminate}" Value="{Binding Percent}" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <StackPanel x:Name="EmptyPanel" Spacing="12" Margin="20,36" MinHeight="100" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock x:Name="EmptyNotice" Text="当前会话暂无任务记录" Classes="muted" FontSize="13" MaxWidth="440" TextWrapping="Wrap" TextAlignment="Center" />
            <Button x:Name="ClearFiltersButton" Content="清除筛选" Classes="soft" HorizontalAlignment="Center" Click="ClearFilters" IsVisible="False" />
          </StackPanel>
        </Grid>
      </Border>

      <Border Grid.Row="1" x:Name="LogDetails" Classes="inset-group" Padding="16,14" MaxHeight="280" VerticalAlignment="Top">
        <Grid RowDefinitions="Auto,Auto,*" RowSpacing="8">
          <TextBlock x:Name="DetailTitle" Text="任务详情" FontSize="14" FontWeight="Medium" TextWrapping="Wrap" LineHeight="22" />
          <WrapPanel Grid.Row="1">
            <Button x:Name="CancelButton" Content="取消任务" Classes="soft" Margin="0,0,6,0" Click="CancelSelected" IsVisible="False" AutomationProperties.Name="取消所选任务" />
            <Button Content="复制日志" Classes="ghost" Click="CopyLog" Margin="0,0,6,0" />
            <Button x:Name="ExpandLogButton" Content="展开日志" Classes="ghost" Click="ExpandLog" Margin="0,0,6,0" />
            <Button x:Name="RetryButton" Content="重试" Classes="soft" Click="RetrySelected" IsVisible="False" />
          </WrapPanel>
          <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled">
            <SelectableTextBlock x:Name="LogText" Text="选择上方任务查看执行日志。" Classes="muted" FontSize="13" TextWrapping="Wrap" LineHeight="20" />
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>

    <TextBlock Grid.Row="3" Text="" IsVisible="False" />
  </Grid>
</UserControl>
