<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../HelL.Core/HelL.Core.csproj" />
    <ProjectReference Include="../HelL.Remote/HelL.Remote.csproj" />
    <PackageReference Include="Avalonia" Version="12.1.6" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.6" />
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
    <Compile Include="../HelL.Desktop/Controls/ProjectPicture.cs" Link="Controls/ProjectPicture.cs" />
    <Compile Include="../HelL.Desktop/Services/DesktopImages.cs" Link="Services/DesktopImages.cs" />
    <Compile Include="../HelL.Desktop/Services/ImageBounds.cs" Link="Services/ImageBounds.cs" />
    <Compile Include="../HelL.Design/IconCatalog.cs" Link="Design/IconCatalog.cs" />
    <Compile Include="../HelL.Design/LauncherIcon.cs" Link="Design/LauncherIcon.cs" />
    <AvaloniaResource Include="../HelL/Resources/Brand/Helstera.png" Link="Assets/Helstera.png" />
    <AvaloniaResource Include="Assets/*.png" />
    <AvaloniaResource Include="Assets/Fonts/*.otf" />
    <AvaloniaResource Include="Assets/NotoSansSC-OFL.txt" Link="Assets/Licenses/NotoSansSC-OFL.txt" />
    <AvaloniaResource Include="../HelL.Design/AvaloniaTokens.axaml" Link="Assets/Design/AvaloniaTokens.axaml" />
  </ItemGroup>
</Project>
