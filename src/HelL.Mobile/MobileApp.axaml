<Application xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="HelL.Mobile.MobileApp" RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme />
    <Style Selector="UserControl"><Setter Property="FontFamily" Value="Noto Sans CJK SC, Microsoft YaHei UI, PingFang SC, sans-serif" /><Setter Property="FontSize" Value="16" /></Style>
    <Style Selector="Button"><Setter Property="MinHeight" Value="44" /><Setter Property="Padding" Value="14,10" /><Setter Property="CornerRadius" Value="8" /><Setter Property="Background" Value="#26353D" /></Style>
    <Style Selector="TextBox"><Setter Property="MinHeight" Value="44" /><Setter Property="FontSize" Value="16" /></Style>
    <Style Selector="ComboBox"><Setter Property="MinHeight" Value="44" /><Setter Property="FontSize" Value="16" /></Style>
    <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="#A9B9C1" /></Style>
    <Style Selector="Button.current"><Setter Property="Background" Value="#305363" /></Style>
  </Application.Styles>
</Application>
