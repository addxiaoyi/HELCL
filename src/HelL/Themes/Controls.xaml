              <TextBlock Name="Ph" Style="{StaticResource T.Control}" FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" Foreground="{DynamicResource B.InkFaint}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" TextTrimming="CharacterEllipsis" Visibility="Collapsed" Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
