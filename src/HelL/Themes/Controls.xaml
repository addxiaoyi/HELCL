  <Style TargetType="{x:Type ListBox}" BasedOn="{StaticResource PlainList}" />
  <Style TargetType="{x:Type ListBoxItem}" BasedOn="{StaticResource ListItemRow}" />
  <Style TargetType="{x:Type ListView}" BasedOn="{StaticResource PlainList}" />
  <Style TargetType="{x:Type ListViewItem}" BasedOn="{StaticResource ListItemRow}" />
