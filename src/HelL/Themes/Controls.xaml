  <Style x:Key="{x:Type MenuItem}" TargetType="{x:Type MenuItem}">
    <Setter Property="FontFamily" Value="{DynamicResource F.Ui}" />
    <Setter Property="FontSize" Value="{x:Static ui:UiMetrics.BodySize}" />
    <Setter Property="Foreground" Value="{DynamicResource B.Ink}" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="MinHeight" Value="{x:Static ui:UiMetrics.ControlHeight}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type MenuItem}">
          <Grid>
            <Border Name="Bd" Background="Transparent" CornerRadius="4" />
            <Grid Margin="{TemplateBinding Padding}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="20" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="16" />
              </Grid.ColumnDefinitions>
              <ContentPresenter Name="Icon" ContentSource="Icon" VerticalAlignment="Center" />
              <Path Name="Check" Data="M1,5 L4,8 L10,1" Stroke="{DynamicResource B.AccentText}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center" Visibility="Collapsed" />
              <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" />
              <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}" Foreground="{DynamicResource B.InkMuted}" Margin="20,0,4,0" VerticalAlignment="Center" />
              <Path Name="Arrow" Grid.Column="3" Data="M0,0 L4,4 L0,8" Stroke="{DynamicResource B.InkMuted}" StrokeThickness="1.4" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed" />
            </Grid>
            <Popup Name="PART_Popup" Placement="Right" HorizontalOffset="-2" VerticalOffset="-5" AllowsTransparency="True" Focusable="False" IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}">
              <ui:PopupShadow Margin="8" UseLayoutRounding="True">
              <Border Background="{DynamicResource B.Popup}" BorderBrush="{DynamicResource B.PopupBorder}" BorderThickness="1" CornerRadius="8" Padding="4">
                <ScrollViewer CanContentScroll="True" MaxHeight="480" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                  <ItemsPresenter Name="ItemsPresenter" KeyboardNavigation.DirectionalNavigation="Cycle" KeyboardNavigation.TabNavigation="Cycle" />
                </ScrollViewer>
              </Border>
              </ui:PopupShadow>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource B.Hover}" /></Trigger>
            <Trigger Property="IsSubmenuOpen" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource B.AccentSoft}" /></Trigger>
            <Trigger Property="HasItems" Value="True"><Setter TargetName="Arrow" Property="Visibility" Value="Visible" /></Trigger>
            <Trigger Property="IsChecked" Value="True"><Setter TargetName="Check" Property="Visibility" Value="Visible" /><Setter TargetName="Icon" Property="Visibility" Value="Collapsed" /></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.42" /></Trigger>
            <Trigger Property="Role" Value="TopLevelHeader"><Setter TargetName="PART_Popup" Property="Placement" Value="Bottom" /></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="Skin.Side" TargetType="{x:Type Border}">
    <Setter Property="BorderThickness" Value="0,0,1,0" />
    <Setter Property="UIElement.SnapsToDevicePixels" Value="True" />
  </Style>
  <Style x:Key="Skin.NavItem" TargetType="{x:Type ToggleButton}" BasedOn="{StaticResource NavItem}" />
  <Style x:Key="Skin.Caption" TargetType="{x:Type Button}" BasedOn="{StaticResource Btn.Caption}" />
  <!-- macOS 红黄绿圆点：14px 圆，悬停 / 按下靠压暗反馈。基础样式必须排在派生样式之前，StaticResource 只查前向声明 -->
  <Style x:Key="Skin.Dot" TargetType="{x:Type Button}">
    <Setter Property="Width" Value="34" />
    <Setter Property="Height" Value="32" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="Background" Value="{DynamicResource B.InkFaintRaw}" />
    <Setter Property="BorderBrush" Value="{DynamicResource B.Seam}" />
    <Setter Property="BorderThickness" Value="0.5" />
    <Setter Property="FrameworkElement.Cursor" Value="Hand" />
    <Setter Property="FrameworkElement.FocusVisualStyle" Value="{StaticResource Focus.Ring}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Grid Background="Transparent">
            <Border x:Name="Hot" CornerRadius="5" Background="{DynamicResource B.Hover}" Opacity="0" />
            <Ellipse Name="Dot" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="{TemplateBinding Control.Background}" Stroke="{TemplateBinding Control.BorderBrush}" StrokeThickness="{TemplateBinding Control.BorderThickness}" />
            <TextBlock x:Name="Symbol" Style="{StaticResource T.Glyph}" Text="{TemplateBinding Content}" FontFamily="Segoe MDL2 Assets" FontSize="8" Foreground="#CC172018" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="Hot" Property="Opacity" Value="1" />
              <Setter TargetName="Symbol" Property="Opacity" Value="1" />
            </Trigger>
            <Trigger Property="ui:SnapCaption.Hovered" Value="True"><Setter TargetName="Hot" Property="Opacity" Value="1" /><Setter TargetName="Symbol" Property="Opacity" Value="1" /></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Symbol" Property="Opacity" Value="1" /></Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Dot" Property="UIElement.Opacity" Value="0.66" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="Skin.DotClose" TargetType="{x:Type Button}" BasedOn="{StaticResource Skin.Dot}">
    <Setter Property="Background" Value="#FF5F57" />
    <Setter Property="BorderBrush" Value="#E0443E" />
  </Style>
  <Style x:Key="Skin.DotMin" TargetType="{x:Type Button}" BasedOn="{StaticResource Skin.Dot}">
    <Setter Property="Background" Value="#FEBC2E" />
    <Setter Property="BorderBrush" Value="#DEA123" />
  </Style>
  <Style x:Key="Skin.DotMax" TargetType="{x:Type Button}" BasedOn="{StaticResource Skin.Dot}">
    <Setter Property="Background" Value="#28C840" />
    <Setter Property="BorderBrush" Value="#1AAB29" />
  </Style>
</ResourceDictionary>
