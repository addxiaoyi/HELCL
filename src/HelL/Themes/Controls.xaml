<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:sys="clr-namespace:System;assembly=System.Runtime" xmlns:ui="clr-namespace:HelL.Services">
  <FontFamily x:Key="F.Ui">Segoe UI Variable Text, Noto Sans SC, Microsoft YaHei UI, Segoe UI</FontFamily>
  <FontFamily x:Key="F.Mono">Cascadia Mono, Consolas, Microsoft YaHei UI, monospace</FontFamily>
  <system:Double x:Key="R.Card" xmlns:system="clr-namespace:System;assembly=mscorlib">14</system:Double>
  <CornerRadius x:Key="CR.Card">14</CornerRadius>
  <CornerRadius x:Key="CR.Ctl">9</CornerRadius>
  <CornerRadius x:Key="CR.Pill">14</CornerRadius>
  <Duration x:Key="D.Fast">0:0:0.13</Duration>
  <Duration x:Key="D.Med">0:0:0.18</Duration>
  <CubicEase x:Key="E.Out" EasingMode="EaseOut" />
  <QuadraticEase x:Key="E.InOut" EasingMode="EaseInOut" />
  <Style x:Key="Focus.Ring">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Border BorderBrush="{DynamicResource B.Accent}" BorderThickness="2" CornerRadius="{StaticResource CR.Ctl}" Margin="-3" SnapsToDevicePixels="True" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="T.Control" TargetType="{x:Type TextBlock}">
    <Setter Property="Effect" Value="{DynamicResource E.TextContrast}" />
    <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
    <Setter Property="UIElement.SnapsToDevicePixels" Value="True" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style x:Key="T.Glyph" TargetType="{x:Type TextBlock}">
    <Setter Property="Effect" Value="{DynamicResource E.TextContrast}" />
    <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="TextAlignment" Value="Center" />
  </Style>
  <Style x:Key="{x:Type TextBlock}" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource T.Control}">
    <Setter Property="VerticalAlignment" Value="Stretch" />
  </Style>
  <!-- Control text inherits its owner's size; body defaults belong to the window. -->
  <Style TargetType="Window">
    <Setter Property="FontFamily" Value="{DynamicResource F.Ui}" />
    <Setter Property="FontSize" Value="{x:Static ui:UiMetrics.BodySize}" />
    <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
  </Style>
  <Style x:Key="T.H1" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
    <Setter Property="FontFamily" Value="{DynamicResource F.Ui}" />
    <Setter Property="FontSize" Value="{x:Static ui:UiMetrics.TitleSize}" />
    <Setter Property="LineHeight" Value="{x:Static ui:UiMetrics.TitleLine}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource B.Ink}" />
  </Style>
  <Style x:Key="T.H2" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
    <Setter Property="FontFamily" Value="{DynamicResource F.Ui}" />
    <Setter Property="FontSize" Value="{x:Static ui:UiMetrics.HeadingSize}" />
    <Setter Property="LineHeight" Value="{x:Static ui:UiMetrics.HeadingLine}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource B.Ink}" />
  </Style>
  <Style x:Key="T.H3" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
    <Setter Property="FontFamily" Value="{DynamicResource F.Ui}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource B.Ink}" />
  </Style>
  <Style x:Key="T.Muted" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource {x:Type TextBlock}}">
    <Setter Property="FontFamily" Value="{DynamicResource F.Ui}" />
    <Setter Property="FontSize" Value="{x:Static ui:UiMetrics.CaptionSize}" />
    <Setter Property="LineHeight" Value="{x:Static ui:UiMetrics.CaptionLine}" />
    <Setter Property="Foreground" Value="{DynamicResource B.InkMuted}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style x:Key="T.Small" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource T.Muted}">
    <Setter Property="FontFamily" Value="{DynamicResource F.Ui}" />
    <Setter Property="FontSize" Value="{x:Static ui:UiMetrics.CaptionSize}" />
    <Setter Property="Foreground" Value="{DynamicResource B.InkFaint}" />
  </Style>
  <Style x:Key="T.Mono" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource T.Muted}">
    <Setter Property="FontFamily" Value="{StaticResource F.Mono}" />
    <Setter Property="FontSize" Value="{x:Static ui:UiMetrics.CaptionSize}" />
    <Setter Property="Foreground" Value="{DynamicResource B.InkSoft}" />
  </Style>
  <Style x:Key="Card" TargetType="{x:Type Border}">
    <Setter Property="Background" Value="{DynamicResource B.Card}" />
    <Setter Property="BorderBrush" Value="{DynamicResource B.CardBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Border.CornerRadius" Value="{StaticResource CR.Card}" />
    <Setter Property="Border.Padding" Value="16" />
    <Setter Property="UIElement.SnapsToDevicePixels" Value="True" />
  </Style>
  <Style x:Key="CardFlat" TargetType="{x:Type Border}" BasedOn="{StaticResource Card}">
    <Setter Property="Background" Value="{DynamicResource B.SurfaceInset}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Border.Padding" Value="12" />
  </Style>
  <Style x:Key="List.Row" TargetType="{x:Type Border}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource B.LineSoft}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{DynamicResource B.Hover}" />
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="ScrollThumb" TargetType="{x:Type Thumb}">
    <Setter Property="FrameworkElement.OverridesDefaultStyle" Value="True" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Thumb}">
          <Border Name="R" Background="{DynamicResource B.Scroll}" CornerRadius="4" Margin="3,2" Opacity="0.55" />
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="R" Value="{DynamicResource B.ScrollHover}" Property="Border.Background" />
              <Setter TargetName="R" Property="UIElement.Opacity" Value="1" />
              <Setter TargetName="R" Property="FrameworkElement.Margin" Value="2,1" />
            </Trigger>
            <Trigger Property="Thumb.IsDragging" Value="True">
              <Setter TargetName="R" Value="{DynamicResource B.ScrollHover}" Property="Border.Background" />
              <Setter TargetName="R" Property="UIElement.Opacity" Value="1" />
              <Setter TargetName="R" Property="FrameworkElement.Margin" Value="2,1" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="{x:Type ScrollBar}" TargetType="{x:Type ScrollBar}">
    <Setter Property="FrameworkElement.OverridesDefaultStyle" Value="True" />
    <Setter Property="Background" Value="#00FFFFFF" />
    <Setter Property="Width" Value="10" />
    <Setter Property="MinWidth" Value="10" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ScrollBar}">
          <Grid Background="#00FFFFFF">
            <Track Name="PART_Track" IsDirectionReversed="True">
              <Track.DecreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" IsTabStop="False">
                  <Control.Template>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                      <Border Background="#00FFFFFF" />
                    </ControlTemplate>
                  </Control.Template>
                </RepeatButton>
              </Track.DecreaseRepeatButton>
              <Track.Thumb>
                <Thumb Style="{StaticResource ScrollThumb}" />
              </Track.Thumb>
              <Track.IncreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" IsTabStop="False">
                  <Control.Template>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                      <Border Background="#00FFFFFF" />
                    </ControlTemplate>
                  </Control.Template>
                </RepeatButton>
              </Track.IncreaseRepeatButton>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="ScrollBar.Orientation" Value="Horizontal">
        <Setter Property="Width" Value="Auto" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Height" Value="10" />
        <Setter Property="MinHeight" Value="10" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ScrollBar}">
              <Grid Background="#00FFFFFF">
                <Track Name="PART_Track" IsDirectionReversed="False">
                  <Track.DecreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageLeftCommand" Opacity="0" Focusable="False" IsTabStop="False">
                      <Control.Template>
                        <ControlTemplate TargetType="{x:Type RepeatButton}">
                          <Border Background="#00FFFFFF" />
                        </ControlTemplate>
                      </Control.Template>
                    </RepeatButton>
                  </Track.DecreaseRepeatButton>
                  <Track.Thumb>
                    <Thumb Style="{StaticResource ScrollThumb}" />
                  </Track.Thumb>
                  <Track.IncreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageRightCommand" Opacity="0" Focusable="False" IsTabStop="False">
                      <Control.Template>
                        <ControlTemplate TargetType="{x:Type RepeatButton}">
                          <Border Background="#00FFFFFF" />
                        </ControlTemplate>
                      </Control.Template>
                    </RepeatButton>
                  </Track.IncreaseRepeatButton>
                </Track>
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style TargetType="{x:Type ScrollViewer}">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Background" Value="#00FFFFFF" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ScrollViewer}">
          <Grid Background="{TemplateBinding Background}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ScrollContentPresenter Name="PART_ScrollContentPresenter" Grid.Row="0" Grid.Column="0" CanContentScroll="{TemplateBinding CanContentScroll}" Margin="{TemplateBinding Padding}" />
            <ScrollBar Name="PART_VerticalScrollBar" Grid.Row="0" Grid.Column="1" Value="{TemplateBinding VerticalOffset}" Maximum="{TemplateBinding ScrollableHeight}" ViewportSize="{TemplateBinding ViewportHeight}" Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
            <ScrollBar Name="PART_HorizontalScrollBar" Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Value="{TemplateBinding HorizontalOffset}" Maximum="{TemplateBinding ScrollableWidth}" ViewportSize="{TemplateBinding ViewportWidth}" Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="{x:Type Separator}">
    <Setter Property="Background" Value="{DynamicResource B.LineSoft}" />
    <Setter Property="Height" Value="1" />
    <Setter Property="Margin" Value="0,4" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Separator}">
          <Border Background="{TemplateBinding Background}" Height="{TemplateBinding Height}" SnapsToDevicePixels="True" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <ControlTemplate x:Key="BtnTpl" TargetType="{x:Type ButtonBase}">
    <Grid Name="Root">
      <Border Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource CR.Ctl}" />
      <Border Name="Ov" Background="{DynamicResource B.Ink}" Opacity="0" CornerRadius="{StaticResource CR.Ctl}" />
      <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True" />
    </Grid>
    <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Ov" Property="Opacity" Value="0.06" /></Trigger>
      <Trigger Property="IsPressed" Value="True"><Setter TargetName="Ov" Property="Opacity" Value="0.13" /></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Root" Property="Opacity" Value="0.42" /></Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>
  <Style x:Key="Btn.Base" TargetType="{x:Type ButtonBase}">
    <Setter Property="FontFamily" Value="{DynamicResource F.Ui}" />
    <Setter Property="FontSize" Value="{x:Static ui:UiMetrics.BodySize}" />
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="MinHeight" Value="{x:Static ui:UiMetrics.ControlHeight}" />
    <Setter Property="FrameworkElement.Cursor" Value="Hand" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FrameworkElement.FocusVisualStyle" Value="{StaticResource Focus.Ring}" />
    <Setter Property="Template" Value="{StaticResource BtnTpl}" />
    <Setter Property="UIElement.SnapsToDevicePixels" Value="True" />
  </Style>
  <Style x:Key="Btn.Primary" TargetType="{x:Type ButtonBase}" BasedOn="{StaticResource Btn.Base}">
    <Setter Property="Background" Value="{DynamicResource B.AccentStrong}" />
    <Setter Property="BorderBrush" Value="{DynamicResource B.AccentStrong}" />
    <Setter Property="Foreground" Value="{DynamicResource B.OnAccentStrong}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style x:Key="Btn.Soft" TargetType="{x:Type ButtonBase}" BasedOn="{StaticResource Btn.Base}">
    <Setter Property="Background" Value="{DynamicResource B.AccentSoft}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource B.AccentText}" />
  </Style>
  <Style x:Key="Btn.Normal" TargetType="{x:Type ButtonBase}" BasedOn="{StaticResource Btn.Base}">
    <Setter Property="Background" Value="{DynamicResource B.ControlFill}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource B.Ink}" />
  </Style>
  <Style TargetType="{x:Type Button}" BasedOn="{StaticResource Btn.Normal}">
    <Setter Property="FrameworkElement.FocusVisualStyle" Value="{StaticResource Focus.Ring}" />
  </Style>
  <Style TargetType="{x:Type RepeatButton}" BasedOn="{StaticResource Btn.Normal}">
    <Setter Property="FrameworkElement.FocusVisualStyle" Value="{StaticResource Focus.Ring}" />
  </Style>
  <Style TargetType="{x:Type ToggleButton}" BasedOn="{StaticResource Btn.Normal}">
    <Setter Property="FrameworkElement.FocusVisualStyle" Value="{StaticResource Focus.Ring}" />
  </Style>
  <Style x:Key="Btn.Ghost" TargetType="{x:Type ButtonBase}" BasedOn="{StaticResource Btn.Base}">
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Background" Value="#00FFFFFF" />
    <Setter Property="BorderBrush" Value="#00FFFFFF" />
    <Setter Property="Foreground" Value="{DynamicResource B.InkSoft}" />
  </Style>
  <Style x:Key="Glass.Card" TargetType="{x:Type Border}" BasedOn="{StaticResource Card}">
    <Setter Property="Background" Value="{DynamicResource B.Card}" />
    <Setter Property="BorderBrush" Value="{DynamicResource B.CardBorder}" />
    <Setter Property="UIElement.SnapsToDevicePixels" Value="True" />
  </Style>
  <Style x:Key="Glass.NavItem" TargetType="{x:Type ToggleButton}" BasedOn="{StaticResource NavItem}">
    <Setter Property="Margin" Value="8,3,8,0" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
  </Style>
  <Style x:Key="Btn.Danger" TargetType="{x:Type ButtonBase}" BasedOn="{StaticResource Btn.Base}">
    <Setter Property="Background" Value="{DynamicResource B.DangerSoft}" />
    <Setter Property="BorderBrush" Value="{DynamicResource B.DangerSoft}" />
    <Setter Property="Foreground" Value="{DynamicResource B.Danger}" />
  </Style>
  <Style x:Key="Btn.Icon" TargetType="{x:Type ButtonBase}" BasedOn="{StaticResource Btn.Ghost}">
    <Setter Property="Padding" Value="7" />
    <Setter Property="MinWidth" Value="34" />
    <Setter Property="FontSize" Value="{x:Static ui:UiMetrics.BodySize}" />
  </Style>
  <Style x:Key="Btn.Chip" TargetType="{x:Type ButtonBase}" BasedOn="{StaticResource Btn.Base}">
    <Setter Property="Background" Value="{DynamicResource B.ControlFill}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource B.InkSoft}" />
    <Setter Property="Padding" Value="11,6" />
    <Setter Property="FontSize" Value="{x:Static ui:UiMetrics.CaptionSize}" />
  </Style>
  <Style x:Key="Btn.OnBanner" TargetType="{x:Type ButtonBase}" BasedOn="{StaticResource Btn.Base}">
    <Setter Property="Background" Value="{DynamicResource B.OnBanner}" />
    <Setter Property="BorderBrush" Value="{DynamicResource B.OnBanner}" />
    <Setter Property="Foreground" Value="{DynamicResource B.AccentStrong}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style TargetType="{x:Type Label}">
    <Setter Property="Foreground" Value="{DynamicResource B.Ink}" />
    <Setter Property="FontFamily" Value="{DynamicResource F.Ui}" />
    <Setter Property="FontSize" Value="{x:Static ui:UiMetrics.BodySize}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Label}">
          <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="{x:Type TabItem}">
    <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Ring}" />
    <Setter Property="Foreground" Value="{DynamicResource B.InkMuted}" />
    <Setter Property="FontFamily" Value="{DynamicResource F.Ui}" />
    <Setter Property="FontSize" Value="{x:Static ui:UiMetrics.BodySize}" />
    <Setter Property="Padding" Value="14,6" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type TabItem}">
          <Grid Margin="2,0">
            <Border Name="Bd" Background="#00FFFFFF" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter Name="Cp" ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" TextElement.FontSize="{TemplateBinding FontSize}" TextElement.FontWeight="Normal" />
            </Border>
            <Border Name="Underline" Height="2" Background="{DynamicResource B.Accent}" VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Margin="8,0,8,0" Opacity="0" CornerRadius="1" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Value="{DynamicResource B.Hover}" Property="Background" />
              <Setter Property="Foreground" Value="{DynamicResource B.Ink}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Bd" Value="{DynamicResource B.AccentSoft}" Property="Background" />
              <Setter TargetName="Underline" Property="Opacity" Value="1" />
              <Setter Property="Foreground" Value="{DynamicResource B.AccentText}" />
              <Setter TargetName="Cp" Property="TextElement.FontWeight" Value="SemiBold" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="{x:Type TabControl}">
    <Setter Property="Background" Value="#00FFFFFF" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0,8,0,0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type TabControl}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="{DynamicResource B.ControlFill}" CornerRadius="10" Padding="3" HorizontalAlignment="Left" BorderThickness="0">
              <TabPanel IsItemsHost="True" />
            </Border>
            <Border Grid.Row="1" Margin="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
              <ContentPresenter Name="PART_SelectedContentHost" ContentSource="SelectedContent" />
            </Border>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="{x:Type Expander}">
    <Setter Property="Foreground" Value="{DynamicResource B.Ink}" />
    <Setter Property="FontFamily" Value="{DynamicResource F.Ui}" />
    <Setter Property="FontSize" Value="{x:Static ui:UiMetrics.BodySize}" />
    <Setter Property="Background" Value="{DynamicResource B.Card}" />
    <Setter Property="BorderBrush" Value="{DynamicResource B.CardBorder}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="16,12" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Expander}">
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource CR.Card}" SnapsToDevicePixels="True">
            <DockPanel>
              <ToggleButton Name="HeaderSite" DockPanel.Dock="Top" Focusable="True" FocusVisualStyle="{StaticResource Focus.Ring}" IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" Cursor="Hand" Padding="{TemplateBinding Padding}" Content="{TemplateBinding Header}" AutomationProperties.Name="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}">
                <Control.Template>
                  <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Border Background="#00FFFFFF" Padding="{TemplateBinding Padding}" CornerRadius="{StaticResource CR.Card}">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ContentPresenter Grid.Column="0" VerticalAlignment="Center" TextElement.FontWeight="SemiBold" TextElement.Foreground="{DynamicResource B.Ink}" />
                        <Path Name="Arrow" Grid.Column="1" Data="M0,0 L4.5,5 L9,0" Stroke="{DynamicResource B.InkMuted}" StrokeThickness="1.5" VerticalAlignment="Center" Margin="10,0,0,0" RenderTransformOrigin="0.5,0.5">
                          <UIElement.RenderTransform>
                            <RotateTransform x:Name="ArrowR" Angle="0" />
                          </UIElement.RenderTransform>
                        </Path>
                      </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsChecked" Value="True">
                        <Setter TargetName="Arrow" Property="RenderTransform">
                          <Setter.Value>
                            <RotateTransform Angle="180" />
                          </Setter.Value>
                        </Setter>
                      </Trigger>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Arrow" Property="Stroke" Value="{DynamicResource B.Accent}" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Control.Template>
              </ToggleButton>
              <ContentPresenter Name="ExpandSite" DockPanel.Dock="Bottom" Visibility="Collapsed" Margin="{TemplateBinding Padding}" />
            </DockPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsExpanded" Value="True">
              <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="Expander.Inline" TargetType="{x:Type Expander}">
    <Setter Property="Foreground" Value="{DynamicResource B.Ink}" />
    <Setter Property="FontFamily" Value="{DynamicResource F.Ui}" />
    <Setter Property="FontSize" Value="{x:Static ui:UiMetrics.BodySize}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="6,6" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Expander}">
          <DockPanel>
            <ToggleButton Name="HeaderSite" DockPanel.Dock="Top" HorizontalAlignment="Left" Focusable="True" FocusVisualStyle="{StaticResource Focus.Ring}" IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" Cursor="Hand" Padding="{TemplateBinding Padding}" Content="{TemplateBinding Header}" AutomationProperties.Name="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}">
              <Control.Template>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                  <Border Name="HdrBd" Background="#00FFFFFF" Padding="{TemplateBinding Padding}" CornerRadius="{StaticResource CR.Ctl}">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <ContentPresenter Grid.Column="0" VerticalAlignment="Center" TextElement.FontWeight="SemiBold" TextElement.Foreground="{DynamicResource B.InkSoft}" />
                      <Path Name="Arrow" Grid.Column="1" Data="M0,0 L4,4.5 L8,0" Stroke="{DynamicResource B.InkMuted}" StrokeThickness="1.5" VerticalAlignment="Center" Margin="7,0,2,0" RenderTransformOrigin="0.5,0.5">
                        <UIElement.RenderTransform>
                          <RotateTransform x:Name="ArrowR" Angle="0" />
                        </UIElement.RenderTransform>
                      </Path>
                    </Grid>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True">
                      <Setter TargetName="Arrow" Property="RenderTransform">
                        <Setter.Value>
                          <RotateTransform Angle="180" />
                        </Setter.Value>
                      </Setter>
