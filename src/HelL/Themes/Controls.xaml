            <Border Name="Ov" Background="{DynamicResource B.Ink}" Opacity="0" />
            <Border Name="Bar" Width="5" CornerRadius="2" HorizontalAlignment="Left" Margin="0,6,0,6" Background="{DynamicResource B.Accent}" Opacity="0" RenderTransformOrigin="0.5,0.5">
