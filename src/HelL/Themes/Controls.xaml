                      <Setter TargetName="HdrBd" Property="Background" Value="{DynamicResource B.Hover}" />
                      <Setter TargetName="Arrow" Property="Stroke" Value="{DynamicResource B.Accent}" />
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Control.Template>
            </ToggleButton>
            <ContentPresenter Name="ExpandSite" DockPanel.Dock="Bottom" Visibility="Collapsed" Margin="0,6,0,4" />
          </DockPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsExpanded" Value="True">
