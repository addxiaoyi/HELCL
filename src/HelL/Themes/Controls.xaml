    <Setter Property="FontFamily" Value="{DynamicResource F.Ui}" />
    <Setter Property="FontSize" Value="{x:Static ui:UiMetrics.BodySize}" />
    <Setter Property="Foreground" Value="{DynamicResource B.Ink}" />
    <Setter Property="MinHeight" Value="{x:Static ui:UiMetrics.ControlHeight}" />
    <Setter Property="Padding" Value="10,6,32,6" />
    <Setter Property="FrameworkElement.Cursor" Value="Hand" />
    <Setter Property="FrameworkElement.FocusVisualStyle" Value="{StaticResource Focus.Ring}" />
    <Setter Property="ItemContainerStyle" Value="{StaticResource ComboItem}" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ComboBox}">
          <Grid>
            <ToggleButton Name="PART_Tg" Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
              <Control.Template>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                  <Grid>
                    <Border Name="Bd" Background="{DynamicResource B.ControlFill}" BorderBrush="Transparent" BorderThickness="1.5" CornerRadius="{StaticResource CR.Ctl}" />
                    <Border Name="Ov" Background="{DynamicResource B.Ink}" Opacity="0" CornerRadius="{StaticResource CR.Ctl}" />
                    <Path Name="Ar" Data="M0,0 L4.5,5 L9,0" Stroke="{DynamicResource B.InkMuted}" StrokeThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,11,0" RenderTransformOrigin="0.5,0.5">
                      <UIElement.RenderTransform>
                        <RotateTransform x:Name="ArR" Angle="0" />
                      </UIElement.RenderTransform>
                    </Path>
                  </Grid>
                  <ControlTemplate.Triggers>
                    <Trigger Property="UIElement.IsMouseOver" Value="True">
                      <Setter TargetName="Ov" Property="UIElement.Opacity" Value="0.04" />
                    </Trigger>
                    <Trigger Property="ToggleButton.IsChecked" Value="True">
                      <Setter TargetName="Bd" Value="{DynamicResource B.Accent}" Property="Border.BorderBrush" />
                      <TriggerBase.EnterActions>
                        <BeginStoryboard>
                          <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="ArR" Storyboard.TargetProperty="Angle" To="180" Duration="{StaticResource D.Fast}" />
                          </Storyboard>
                        </BeginStoryboard>
                      </TriggerBase.EnterActions>
                      <TriggerBase.ExitActions>
                        <BeginStoryboard>
                          <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="ArR" Storyboard.TargetProperty="Angle" To="0" Duration="{StaticResource D.Fast}" />
                          </Storyboard>
                        </BeginStoryboard>
                      </TriggerBase.ExitActions>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Control.Template>
            </ToggleButton>
            <ContentPresenter Name="Cp" Content="{TemplateBinding ComboBox.SelectionBoxItem}" ContentTemplate="{TemplateBinding ComboBox.SelectionBoxItemTemplate}" Margin="{TemplateBinding Control.Padding}" IsHitTestVisible="False" VerticalAlignment="Center" HorizontalAlignment="Stretch" ClipToBounds="True" TextElement.Foreground="{TemplateBinding Control.Foreground}" TextElement.FontSize="{TemplateBinding FontSize}" TextElement.FontFamily="{TemplateBinding FontFamily}" />
            <TextBox Name="PART_EditableTextBox" Visibility="Collapsed" Margin="{TemplateBinding Control.Padding}" Background="#00FFFFFF" BorderThickness="0" Padding="0" MinHeight="0" VerticalContentAlignment="Center" FontSize="{TemplateBinding FontSize}" Foreground="{TemplateBinding Foreground}" CaretBrush="{DynamicResource B.Accent}" FontFamily="{TemplateBinding FontFamily}" FocusVisualStyle="{x:Null}">
              <Control.Template>
                <ControlTemplate TargetType="{x:Type TextBox}">
                  <ScrollViewer Name="PART_ContentHost" Focusable="False" VerticalAlignment="Center" />
                </ControlTemplate>
              </Control.Template>
            </TextBox>
            <TextBlock Name="Ph" Style="{StaticResource T.Control}" FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" Text="{TemplateBinding FrameworkElement.Tag}" Foreground="{DynamicResource B.InkFaint}" Margin="{TemplateBinding Control.Padding}" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed" />
            <Popup Name="PART_Popup" AllowsTransparency="True" Placement="Bottom" VerticalOffset="4" IsOpen="{TemplateBinding ComboBox.IsDropDownOpen}" PopupAnimation="None" Focusable="False">
              <ui:PopupShadow Margin="8" UseLayoutRounding="True">
              <Border Background="{DynamicResource B.Popup}" BorderBrush="{DynamicResource B.PopupBorder}" BorderThickness="1" CornerRadius="8" MaxHeight="320" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                <ScrollViewer Margin="0,5" VerticalScrollBarVisibility="Auto">
                  <ItemsPresenter />
                </ScrollViewer>
              </Border>
              </ui:PopupShadow>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="SelectedIndex" Value="-1" />
                <Condition Property="Text" Value="" />
              </MultiTrigger.Conditions>
              <Setter TargetName="Ph" Property="Visibility" Value="Visible" />
            </MultiTrigger>
            <Trigger Property="ComboBox.IsEditable" Value="True">
              <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
              <Setter TargetName="Cp" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="UIElement.Opacity" Value="0.5" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="{x:Type ComboBox}" BasedOn="{StaticResource Combo}" />
  <Style TargetType="{x:Type ComboBoxItem}" BasedOn="{StaticResource ComboItem}" />
  <Style x:Key="Chk" TargetType="{x:Type CheckBox}">
    <Setter Property="FontFamily" Value="{DynamicResource F.Ui}" />
    <Setter Property="FontSize" Value="{x:Static ui:UiMetrics.BodySize}" />
    <Setter Property="Foreground" Value="{DynamicResource B.Ink}" />
    <Setter Property="FrameworkElement.Cursor" Value="Hand" />
    <Setter Property="FrameworkElement.FocusVisualStyle" Value="{StaticResource Focus.Ring}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type CheckBox}">
          <StackPanel Orientation="Horizontal" Background="#00FFFFFF">
            <Grid Width="18" Height="18" VerticalAlignment="Center">
              <Border Name="Bx" CornerRadius="5" Background="{DynamicResource B.Paper}" BorderBrush="{DynamicResource B.Line}" BorderThickness="1.4" />
              <Border Name="Fill" CornerRadius="5" Background="{DynamicResource B.AccentStrong}" Opacity="0" />
              <Path Name="Tick" Data="M0,4 L3.4,7.4 L9.4,1" Stroke="{DynamicResource B.OnAccentStrong}" StrokeThickness="1.8" Opacity="0" HorizontalAlignment="Center" VerticalAlignment="Center" StrokeEndLineCap="Round" StrokeStartLineCap="Round" />
            </Grid>
            <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Control.Foreground}" TextElement.FontSize="{TemplateBinding Control.FontSize}" TextElement.FontFamily="{DynamicResource F.Ui}" />
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="Bx" Value="{DynamicResource B.Accent}" Property="Border.BorderBrush" />
            </Trigger>
            <Trigger Property="ToggleButton.IsChecked" Value="True">
              <Setter TargetName="Fill" Property="Opacity" Value="1" />
              <Setter TargetName="Tick" Property="Opacity" Value="1" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="UIElement.Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="Switch" TargetType="{x:Type CheckBox}">
    <Setter Property="Foreground" Value="{DynamicResource B.Ink}" />
    <Setter Property="FrameworkElement.Cursor" Value="Hand" />
    <Setter Property="FrameworkElement.FocusVisualStyle" Value="{StaticResource Focus.Ring}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type CheckBox}">
          <Grid Width="40" Height="22" Background="#00FFFFFF">
            <Border Name="Tr" CornerRadius="11" Background="{DynamicResource B.Line}" />
            <Border Name="TrOn" CornerRadius="11" Background="{DynamicResource B.Accent}" Opacity="0" />
            <Border Name="Kn" Width="16" Height="16" CornerRadius="8" Background="#FFFFFFFF" HorizontalAlignment="Left" Margin="3,0,0,0">
              <UIElement.RenderTransform>
                <TranslateTransform x:Name="KnT" X="0" />
              </UIElement.RenderTransform>
              <UIElement.Effect>
                <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.25" Color="#000000" />
              </UIElement.Effect>
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="ToggleButton.IsChecked" Value="True">
              <Setter TargetName="TrOn" Property="Opacity" Value="1" />
              <Setter TargetName="Kn" Property="RenderTransform">
                <Setter.Value><TranslateTransform X="18" /></Setter.Value>
              </Setter>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="UIElement.Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="{x:Type CheckBox}" BasedOn="{StaticResource Chk}" />
  <Style x:Key="Radio" TargetType="{x:Type RadioButton}">
    <Setter Property="FontFamily" Value="{DynamicResource F.Ui}" />
    <Setter Property="FontSize" Value="{x:Static ui:UiMetrics.BodySize}" />
    <Setter Property="Foreground" Value="{DynamicResource B.Ink}" />
    <Setter Property="FrameworkElement.Cursor" Value="Hand" />
    <Setter Property="FrameworkElement.FocusVisualStyle" Value="{StaticResource Focus.Ring}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type RadioButton}">
          <StackPanel Orientation="Horizontal" Background="#00FFFFFF">
            <Grid Width="18" Height="18" VerticalAlignment="Center">
              <Ellipse Name="Bx" Stroke="{DynamicResource B.Line}" StrokeThickness="1.4" Fill="{DynamicResource B.Paper}" />
              <Ellipse Name="Dot" Width="9" Height="9" Fill="{DynamicResource B.Accent}" Opacity="0" />
            </Grid>
            <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Control.Foreground}" TextElement.FontSize="{TemplateBinding Control.FontSize}" TextElement.FontFamily="{DynamicResource F.Ui}" />
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="ToggleButton.IsChecked" Value="True">
              <Setter TargetName="Bx" Value="{DynamicResource B.Accent}" Property="Shape.Stroke" />
              <Setter TargetName="Dot" Property="Opacity" Value="1" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="{x:Type RadioButton}" BasedOn="{StaticResource Radio}" />
  <Style x:Key="Choice.Row" TargetType="{x:Type RadioButton}" BasedOn="{StaticResource Radio}">
    <Setter Property="Padding" Value="12" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type RadioButton}">
          <Border x:Name="Frame" CornerRadius="8" Padding="{TemplateBinding Padding}" Background="{DynamicResource B.Paper}" BorderBrush="{DynamicResource B.Line}" BorderThickness="1">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="24" /></Grid.ColumnDefinitions>
              <ContentPresenter />
              <TextBlock x:Name="Mark" Grid.Column="1" Text="✓" Foreground="{DynamicResource B.AccentText}" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Hidden" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource B.Hover}" /></Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Frame" Property="Background" Value="{DynamicResource B.AccentSoft}" />
              <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource B.Accent}" />
              <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value="0.45" /></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="Sld" TargetType="{x:Type Slider}">
    <Setter Property="FrameworkElement.FocusVisualStyle" Value="{StaticResource Focus.Ring}" />
    <Setter Property="Height" Value="24" />
    <Setter Property="Slider.IsMoveToPointEnabled" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Slider}">
          <Grid Background="#00FFFFFF" VerticalAlignment="Center">
            <Border Height="5" CornerRadius="3" Background="{DynamicResource B.LineSoft}" VerticalAlignment="Center" />
            <Track Name="PART_Track">
              <Track.DecreaseRepeatButton>
                <RepeatButton Command="Slider.DecreaseLarge" Focusable="False" IsTabStop="False">
                  <Control.Template>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                      <Grid Background="#00FFFFFF">
                        <Border Height="5" CornerRadius="3" Background="{DynamicResource B.Accent}" VerticalAlignment="Center" />
                      </Grid>
                    </ControlTemplate>
                  </Control.Template>
                </RepeatButton>
              </Track.DecreaseRepeatButton>
              <Track.IncreaseRepeatButton>
                <RepeatButton Command="Slider.IncreaseLarge" Focusable="False" IsTabStop="False">
                  <Control.Template>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                      <Border Background="#00FFFFFF" />
                    </ControlTemplate>
                  </Control.Template>
                </RepeatButton>
              </Track.IncreaseRepeatButton>
              <Track.Thumb>
                <Thumb Name="Th" Width="18" Height="18" Focusable="False">
                  <Control.Template>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                      <Grid RenderTransformOrigin="0.5,0.5">
                        <UIElement.RenderTransform>
                          <ScaleTransform x:Name="TSc" ScaleX="1" ScaleY="1" />
                        </UIElement.RenderTransform>
                        <Ellipse Fill="#FFFFFFFF" Stroke="{DynamicResource B.Accent}" StrokeThickness="4">
                          <UIElement.Effect>
                            <DropShadowEffect BlurRadius="5" ShadowDepth="1" Opacity="0.22" Color="#000000" />
                          </UIElement.Effect>
                        </Ellipse>
                      </Grid>
                      <ControlTemplate.Triggers>
                        <Trigger Property="UIElement.IsMouseOver" Value="True">
                          <TriggerBase.EnterActions>
                            <BeginStoryboard>
                              <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="TSc" Storyboard.TargetProperty="ScaleX" To="1.18" Duration="{StaticResource D.Fast}" />
                                <DoubleAnimation Storyboard.TargetName="TSc" Storyboard.TargetProperty="ScaleY" To="1.18" Duration="{StaticResource D.Fast}" />
                              </Storyboard>
                            </BeginStoryboard>
                          </TriggerBase.EnterActions>
                          <TriggerBase.ExitActions>
                            <BeginStoryboard>
                              <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="TSc" Storyboard.TargetProperty="ScaleX" To="1" Duration="{StaticResource D.Fast}" />
                                <DoubleAnimation Storyboard.TargetName="TSc" Storyboard.TargetProperty="ScaleY" To="1" Duration="{StaticResource D.Fast}" />
                              </Storyboard>
                            </BeginStoryboard>
                          </TriggerBase.ExitActions>
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Control.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.42" /></Trigger>
    </Style.Triggers>
  </Style>
  <Style TargetType="{x:Type Slider}" BasedOn="{StaticResource Sld}" />
  <Style x:Key="Prog" TargetType="{x:Type ProgressBar}">
    <Setter Property="Height" Value="6" />
    <Setter Property="Foreground" Value="{DynamicResource B.Accent}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ProgressBar}">
          <Grid Name="Root" ClipToBounds="True">
            <Border Background="{DynamicResource B.LineSoft}" CornerRadius="3" />
            <Border Name="PART_Track" />
            <Border Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="3" Background="{TemplateBinding Control.Foreground}" />
            <Border Name="Glow" HorizontalAlignment="Left" CornerRadius="3" Width="70" Opacity="0">
              <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                  <GradientStop Color="#00FFFFFF" Offset="0" />
                  <GradientStop Color="#66FFFFFF" Offset="0.5" />
                  <GradientStop Color="#00FFFFFF" Offset="1" />
                </LinearGradientBrush>
              </Border.Background>
              <UIElement.RenderTransform>
                <TranslateTransform x:Name="GlowT" X="-80" />
              </UIElement.RenderTransform>
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="ProgressBar.IsIndeterminate" Value="True">
              <Setter TargetName="PART_Indicator" Property="UIElement.Opacity" Value="0.35" />
            </Trigger>
            <MultiDataTrigger>
              <MultiDataTrigger.Conditions>
                <Condition Binding="{Binding IsIndeterminate, RelativeSource={RelativeSource TemplatedParent}}" Value="True" />
                <Condition Binding="{Binding Enabled, Source={x:Static ui:MotionState.Current}}" Value="True" />
              </MultiDataTrigger.Conditions>
              <Setter TargetName="Glow" Property="UIElement.Opacity" Value="1" />
              <TriggerBase.EnterActions>
                <BeginStoryboard Name="SbGlow">
                  <Storyboard RepeatBehavior="Forever">
                    <DoubleAnimation Storyboard.TargetName="GlowT" Storyboard.TargetProperty="X" From="-80" To="900" Duration="0:0:1.5" />
                  </Storyboard>
                </BeginStoryboard>
              </TriggerBase.EnterActions>
              <TriggerBase.ExitActions>
                <StopStoryboard BeginStoryboardName="SbGlow" />
              </TriggerBase.ExitActions>
            </MultiDataTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="{x:Type ProgressBar}" BasedOn="{StaticResource Prog}" />
  <Style x:Key="ListItemRow" TargetType="{x:Type ListBoxItem}">
