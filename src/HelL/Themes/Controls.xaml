      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ContextMenu}">
          <ui:PopupShadow Margin="8">
          <Border Background="{DynamicResource B.Popup}" BorderBrush="{DynamicResource B.PopupBorder}" BorderThickness="1" CornerRadius="8" Padding="4">
            <ScrollViewer CanContentScroll="True" MaxHeight="480" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
              <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" KeyboardNavigation.TabNavigation="Cycle" />
